MEDIX_APP_ENV=dev
MEDIX_LOG_LEVEL=INFO

# Fill in locally. Never commit API keys or a populated .env file.
MEDIX_LLM_API_KEY=
MEDIX_LLM_BASE_URL=https://api.openai.com/v1
MEDIX_LLM_MODEL_NAME=gpt-4.1-mini

MEDIX_DB_URL=
MEDIX_CHECKPOINT_BACKEND=sqlite

MEDIX_EXECUTION_TIMEOUT_SECONDS=120
MEDIX_HUMAN_REVIEW_TIMEOUT_SECONDS=300
MEDIX_MAX_CLARIFICATION_ROUNDS=3

MEDIX_INTENT_CONFIDENCE_RESOLVED=0.80
MEDIX_INTENT_CONFIDENCE_AMBIGUOUS=0.60

MEDIX_ENABLE_HUMAN_REVIEW=true
MEDIX_ENABLE_LANGSMITH_TRACE=false
MEDIX_LANGSMITH_API_KEY=
